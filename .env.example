# Copie para .env e ajuste os valores. O .env nunca é commitado.
POSTGRES_DB=webwallet_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432   # mude se a 5432 já estiver em uso (ajuste também o DB_URL)

# Variáveis lidas pelo backend
DB_URL=jdbc:postgresql://localhost:5432/webwallet_db
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
